<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient ring keeps the light secondary action defined against the dialog. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFDFDFD"
                android:centerColor="#80CECECE"
                android:endColor="#FFF3F3F3"
                android:angle="0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFFDFDFD" android:endColor="#FFF3F3F3" android:angle="270" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
