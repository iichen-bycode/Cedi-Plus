<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The outer gold edge follows the subtle horizontal border gradient in the design. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFD774"
                android:centerColor="#FFFFBD0D"
                android:endColor="#FFFFBD0D"
                android:angle="0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFC322" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <!-- A soft inset highlight recreates the warm inner edge from the mockup. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFEFC3"
                android:centerColor="#00FFEFC3"
                android:endColor="#30FFEFC3"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#55FFEFC3" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
