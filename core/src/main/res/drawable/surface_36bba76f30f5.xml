<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#fffcfcfc"
                android:centerColor="#ffffe095"
                android:endColor="#ffd1d1d1"
                android:angle="0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#fffdfdfd" android:endColor="#ffdbdbdb" android:angle="270" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
