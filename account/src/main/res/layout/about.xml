<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#ffffff"
    android:focusableInTouchMode="true"
    android:tag="375,768">

    <RelativeLayout
        android:id="@+id/about_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#ffffff"
        android:elevation="1dp"
        android:outlineProvider="none">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/text_about_us"
            android:textColor="#120d01"
            android:textSize="20sp" />
        <ImageView
            android:layout_width="8dp"
            android:layout_height="14dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/art_c15f4959fcd0" />
        <Button
            android:id="@+id/about_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/text_back"
            android:stateListAnimator="@null" />
    </RelativeLayout>

    <ImageView
        android:layout_width="228dp"
        android:layout_height="172dp"
        android:layout_marginTop="99dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/art_578d355f8b67" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:text="@string/text_credit_cedi"
        android:textColor="#120d01"
        android:textSize="30sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/text_thank_you_for_your_interest_we_will_do_our_best_to"
        android:textColor="#120d01"
        android:textSize="14sp" />

    <ImageView
        android:layout_width="218dp"
        android:layout_height="40dp"
        android:layout_marginTop="64dp"
        android:contentDescription="@string/text_start_application_now"
        android:scaleType="fitXY"
        android:src="@drawable/art_73da70c1fbd2"
        android:tag="@string/text_start_application_now" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="162dp"
        android:layout_marginBottom="18dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="@string/text_version_1_0_0"
        android:textColor="#120d01"
        android:textSize="16sp" />
</LinearLayout>
